{
  "name": "sadak-setu-backend",
  "version": "1.0.0",
  "description": "Sadak Setu - AI-Powered Road Health & Maintenance Intelligence System Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "prisma generate && ts-node-dev --respawn --transpile-only src/server.ts",
    "prebuild": "prisma generate",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node src/prisma/seed.ts",
    "test": "prisma generate && vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "sadak-setu",
    "road-maintenance",
    "ai",
    "iot",
    "pothole-detection",
    "prisma",
    "express"
  ],
  "author": "Sadak Setu Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.5",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "prisma": "^6.4.1",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
