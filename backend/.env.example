NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database Connection (NeonDB / PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sadak_setu?schema=public"

# Security & Authentication
JWT_SECRET="sadak-setu-super-secret-production-jwt-key-2026"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="sadak-setu-super-secret-refresh-key-2026"
JWT_REFRESH_EXPIRES_IN="7d"

# AI Service Configuration
AI_MODE=mock
AI_SERVICE_URL="http://localhost:8000"
AI_TIMEOUT_MS=15000

# IoT Configuration
IOT_MODE=mock

# Storage Configuration
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR="./uploads"

# Road Health Scoring Weights
SCORE_WEIGHT_SEVERITY=0.40
SCORE_WEIGHT_DENSITY=0.30
SCORE_WEIGHT_VIBRATION=0.20
SCORE_WEIGHT_LOCATION=0.10
