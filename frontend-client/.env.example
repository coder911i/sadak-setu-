# Sadak Setu Frontend Client Environment Configuration
# Copy this file to .env.local in your Next.js frontend application

# Backend API Base URL (with /api/v1 prefix included)
# NEXT_PUBLIC_ prefix is required for Next.js to expose this to the browser bundle
# Local development example:
NEXT_PUBLIC_API_URL="http://localhost:5000/api/v1"
#
# Production example (replace with your actual backend domain):
# NEXT_PUBLIC_API_URL="https://api.your-sadak-setu-domain.com/api/v1"
#
# For local proxying through Next.js (rewrites /api/v1/* to backend), you may omit
# the host and just use the path:
# NEXT_PUBLIC_API_URL="/api/v1"
