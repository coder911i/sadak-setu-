# Sadak Setu Environment Configuration

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Hostname used for Swagger/OpenAPI server URL generation (production only)
# HOST=api.your-sadak-setu-domain.com
# Set to true in production if serving over HTTPS (used for Swagger server URL)
# USE_HTTPS=true

# Comma-separated list of allowed frontend origins for CORS
# Next.js default ports included: 3000 (standard), 5173 (Vite/dev mode)
# Production: Add your Vercel/frontend domain
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5174

# ============================================================
# FRONTEND (React/Vite) — Set these in frontend .env
# ============================================================
# Development (Local Backend)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
VITE_API_URL=http://localhost:5000/api/v1

# Production (Uncomment for deployment)
# NEXT_PUBLIC_API_URL=https://sadak-setu-backend.onrender.com/api/v1
# VITE_API_URL=https://sadak-setu-backend.onrender.com/api/v1

# Database Connection (NeonDB / PostgreSQL)
# Example: postgresql://username:password@ep-cool-frog-123456.us-east-2.aws.neon.tech/sadak_setu?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sadak_setu?schema=public"

# Security & Authentication
# WARNING: Replace JWT_SECRET and JWT_REFRESH_SECRET with high-entropy random
# values in production. NEVER deploy with the placeholder defaults.
# Generate with: openssl rand -base64 64
JWT_SECRET="replace-with-64-byte-random-string-generated-via-openssl-rand-or-similar"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-64-byte-random-string-separate-from-jwt-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# AI Service Configuration
# AI_MODE: "mock" for independent local development, "live" for calling Python FastAPI microservice
AI_MODE=mock
AI_SERVICE_URL="http://localhost:8000"
AI_TIMEOUT_MS=15000

# IoT Configuration
# IOT_MODE: "mock" for automated simulation, "live" for real hardware ingestion
IOT_MODE=mock

# Sensor ML Configuration
# SENSOR_ML_MODE: "mock" for development, "live" for calling Python ML microservice
SENSOR_ML_MODE=mock
SENSOR_ML_SERVICE_URL="http://localhost:8000"
SENSOR_ML_TIMEOUT_MS=20000
SENSOR_ML_CONFIDENCE_THRESHOLD=0.85
SENSOR_ML_AUTO_COMPLAINT_ENABLED=false
SENSOR_ML_DEDUP_RADIUS_METERS=10.0
SENSOR_ML_DEDUP_WINDOW_SECONDS=300

# Storage Configuration (local | s3 | r2)
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR="./uploads"

# AWS S3 / Cloudflare R2 Credentials (used if STORAGE_PROVIDER is s3 or r2)
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_BUCKET="sadak-setu-media"
STORAGE_ACCESS_KEY="your-r2-or-s3-access-key"
STORAGE_SECRET_KEY="your-r2-or-s3-secret-key"
STORAGE_REGION="auto"

# Road Health Scoring Weights (Configurable)
SCORE_WEIGHT_SEVERITY=0.40
SCORE_WEIGHT_DENSITY=0.30
SCORE_WEIGHT_VIBRATION=0.20
SCORE_WEIGHT_LOCATION=0.10
