# Sadak Setu Environment Configuration

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database Connection (NeonDB / PostgreSQL)
# Example: postgresql://username:password@ep-cool-frog-123456.us-east-2.aws.neon.tech/sadak_setu?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sadak_setu?schema=public"

# Security & Authentication
JWT_SECRET="sadak-setu-super-secret-production-jwt-key-2026"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="sadak-setu-super-secret-refresh-key-2026"
JWT_REFRESH_EXPIRES_IN="7d"

# AI Service Configuration
# AI_MODE: "mock" for independent local development, "live" for calling Python FastAPI microservice
AI_MODE=mock
AI_SERVICE_URL="http://localhost:8000"
AI_TIMEOUT_MS=15000

# IoT Configuration
# IOT_MODE: "mock" for automated simulation, "live" for real hardware ingestion
IOT_MODE=mock

# Storage Configuration (local | s3 | r2)
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR="./uploads"

# AWS S3 / Cloudflare R2 Credentials (used if STORAGE_PROVIDER is s3 or r2)
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_BUCKET="sadak-setu-media"
STORAGE_ACCESS_KEY="your-r2-or-s3-access-key"
STORAGE_SECRET_KEY="your-r2-or-s3-secret-key"
STORAGE_REGION="auto"

# Road Health Scoring Weights (Configurable)
SCORE_WEIGHT_SEVERITY=0.40
SCORE_WEIGHT_DENSITY=0.30
SCORE_WEIGHT_VIBRATION=0.20
SCORE_WEIGHT_LOCATION=0.10
